# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/huanghe_kalemie
# Set to true for hosted databases that need SSL (Render, Neon…)
DATABASE_SSL=false
# Long random string for login sessions (required in production)
SESSION_SECRET=change-me
# First owner account, created on the first start only
OWNER_USERNAME=admin
OWNER_PASSWORD=choose-a-strong-password
# Partner names used on the first start (can be changed later in Settings)
PARTNER_A_NAME=Partner A
PARTNER_B_NAME=Partner B
LOCATION_NAME=Kalemie shop
PORT=5000
